{
  "name": "pokit-note",
  "displayName": "Pokit Note",
  "version": "0.4.0",
  "description": "Collaborate with an AI assistant from your iPhone on to do lists, shopping, notes and more.",
  "author": {
    "name": "BotRelay LLC"
  },
  "repository": "https://github.com/botrelay-ai/pokitnote-cursor-plugin",
  "homepage": "https://github.com/botrelay-ai/pokitnote-cursor-plugin",
  "keywords": ["pokit-note", "notes", "lists", "recipes"],
  "skills": "./skills/",
  "commands": "./commands/",
  "mcpServers": "./mcp.json",
  "variables": {
    "type": "object",
    "properties": {
      "POKITNOTE_API_BASE": {
        "type": "string",
        "title": "Pokit Note address",
        "description": "The Pokit Note server.",
        "default": "https://api.pokitnote.com"
      }
    }
  }
}
